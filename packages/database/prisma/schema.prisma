generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]

  @@map("users")
}

model Tenant {
  id                     String                  @id @default(uuid())
  name                   String
  slug                   String                  @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  appointments           Appointment[]
  customers              Customer[]
  memberships            Membership[]
  roles                  Role[]
  services               Service[]
  staff                  Staff[]
  payments               Payment[]
  customerDocuments      CustomerDocument[]
  customerConsents       CustomerConsent[]
  customerHealthProfiles CustomerHealthProfile[]
  customerCareEvents     CustomerCareEvent[]
  companies              Company[]
  servicePackages        ServicePackage[]
  sales                  Sale[]
  customerPackages       CustomerPackage[]
  sessions               Session[]
  salePayments           SalePayment[]
  chartOfAccounts        ChartOfAccount[]
  journalEntries         JournalEntry[]

  @@map("tenants")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum RoleScope {
  CENTRAL
  COMPANY
  BRANCH
}

model Company {
  id        String        @id @default(uuid())
  tenantId  String
  name      String
  slug      String
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches        Branch[]
  memberships     Membership[]
  roles           Role[]
  chartOfAccounts ChartOfAccount[]
  journalEntries  JournalEntry[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("companies")
}

model Branch {
  id        String       @id @default(uuid())
  companyId String
  name      String
  code      String
  status    BranchStatus @default(ACTIVE)
  address   String?
  phone     String?
  email     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  company                Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  membershipAccess       MembershipBranchAccess[]
  customers              Customer[]
  customerHealthProfiles CustomerHealthProfile[]
  customerDocuments      CustomerDocument[]
  customerConsents       CustomerConsent[]
  customerCareEvents     CustomerCareEvent[]
  appointments           Appointment[]
  staff                  Staff[]
  services               Service[]
  servicePackages        ServicePackage[]
  sales                  Sale[]
  customerPackages       CustomerPackage[]
  sessions               Session[]
  salePayments           SalePayment[]
  journalEntries         JournalEntry[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, status])
  @@map("branches")
}

model Membership {
  id             String                   @id @default(uuid())
  userId         String
  tenantId       String
  companyId      String?
  status         MembershipStatus         @default(ACTIVE)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  roleId         String
  role           Role                     @relation(fields: [roleId], references: [id])
  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company        Company?                 @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchAccesses MembershipBranchAccess[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([companyId])
  @@index([userId])
  @@index([roleId])
  @@map("memberships")
}

model MembershipBranchAccess {
  membershipId String
  branchId     String
  createdAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([membershipId, branchId])
  @@index([branchId])
  @@map("membership_branch_access")
}

model Role {
  id              String           @id @default(uuid())
  tenantId        String
  companyId       String?
  name            String
  slug            String
  description     String?
  scope           RoleScope        @default(COMPANY)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  memberships     Membership[]
  rolePermissions RolePermission[]
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, scope])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  resource        String
  action          String
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Customer {
  id             String                 @id @default(uuid())
  tenantId       String
  branchId       String
  firstName      String
  lastName       String
  phone          String?
  email          String?
  birthDate      DateTime?
  customerSource CustomerSource?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  appointments   Appointment[]
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  healthProfile  CustomerHealthProfile?
  documents      CustomerDocument[]
  consents       CustomerConsent[]
  careEvents     CustomerCareEvent[]
  sales          Sale[]
  packages       CustomerPackage[]

  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, birthDate])
  @@index([tenantId, customerSource])
  @@map("customers")
}

model CustomerHealthProfile {
  branchId      String
  id            String    @id @default(uuid())
  tenantId      String
  customerId    String    @unique
  formVersion   String?
  allergies     String?
  sensitivities String?
  medications   String?
  conditions    String?
  notes         String?
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([branchId])
  @@map("customer_health_profiles")
}

model CustomerDocument {
  branchId    String
  id          String               @id @default(uuid())
  tenantId    String
  customerId  String?
  type        CustomerDocumentType
  version     String
  title       String
  content     String?
  fileUrl     String?
  publishedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer Customer?         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  consents CustomerConsent[]

  @@index([tenantId, type, version])
  @@index([tenantId, customerId])
  @@index([branchId])
  @@map("customer_documents")
}

model CustomerConsent {
  branchId          String
  id                String                @id @default(uuid())
  tenantId          String
  customerId        String
  documentId        String?
  type              CustomerConsentType
  status            CustomerConsentStatus
  documentVersion   String
  acceptedAt        DateTime?
  source            ConsentSource
  ipAddress         String?
  userAgent         String?
  signedAt          DateTime?
  signedDocumentUrl String?
  documentHash      String?
  createdAt         DateTime              @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  document CustomerDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([tenantId, customerId])
  @@index([tenantId, customerId, type])
  @@index([branchId])
  @@map("customer_consents")
}

enum CustomerCareEventType {
  REACTION
  AFTERCARE
  COMPLAINT
  FOLLOW_UP
  INCIDENT
  NOTE
}

enum CustomerCareEventStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum CustomerCary {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CustomerCareSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model CustomerCareEvent {
  branchId      String
  id            String                  @id @default(uuid())
  tenantId      String
  customerId    String
  appointmentId String?
  staffId       String?
  type          CustomerCareEventType
  status        CustomerCareEventStatus @default(OPEN)
  severity      CustomerCareSeverity?
  title         String
  description   String?
  onsetAt       DateTime?
  occurredAt    DateTime                @default(now())
  actionTaken   String?
  followUpAt    DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  staff       Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([tenantId, customerId, occurredAt])
  @@index([tenantId, customerId, status])
  @@index([branchId])
  @@index([tenantId, type])
  @@index([tenantId, followUpAt])
  @@map("customer_care_events")
}

model Staff {
  id           String              @id @default(uuid())
  tenantId     String
  branchId     String
  firstName    String
  lastName     String
  phone        String?
  email        String?
  profile      Json?
  status       StaffStatus         @default(ACTIVE)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  appointments Appointment[]
  careEvents   CustomerCareEvent[]
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@index([tenantId, email])
  @@map("staff")
}

model Service {
  id              String        @id @default(uuid())
  tenantId        String
  branchId        String
  name            String
  description     String?
  durationMinutes Int
  price           Decimal       @db.Decimal(10, 2)
  status          ServiceStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  appointments    Appointment[]
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  packageItems    PackageItem[]
  saleItems       SaleItem[]
  sessions        Session[]

  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@map("services")
}

model Appointment {
  id         String            @id @default(uuid())
  tenantId   String
  branchId   String
  customerId String
  staffId    String
  serviceId  String
  startAt    DateTime
  endAt      DateTime
  status     AppointmentStatus @default(SCHEDULED)
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  branch     Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer   Customer            @relation(fields: [customerId], references: [id])
  service    Service             @relation(fields: [serviceId], references: [id])
  staff      Staff               @relation(fields: [staffId], references: [id])
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment    Payment?
  careEvents CustomerCareEvent[]
  session    Session?

  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId])
  @@index([tenantId, branchId, startAt])
  @@index([tenantId, startAt])
  @@index([tenantId, customerId])
  @@index([tenantId, staffId])
  @@index([tenantId, status])
  @@map("appointments")
}

model Payment {
  id            String        @id @default(uuid())
  tenantId      String
  appointmentId String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        PaymentStatus @default(COMPLETED)
  paidAt        DateTime      @default(now())
  refundedAt    DateTime?
  refundReason  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, paidAt])
  @@index([tenantId, method])
  @@index([tenantId, status])
  @@map("payments")
}

model ServicePackage {
  id           String            @id @default(uuid())
  tenantId     String
  branchId     String
  name         String
  description  String?
  price        Decimal           @db.Decimal(10, 2)
  validityDays Int?
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items            PackageItem[]
  saleItems        SaleItem[]
  customerPackages CustomerPackage[]

  @@index([tenantId, branchId])
  @@index([tenantId, active])
  @@map("service_packages")
}

model PackageItem {
  id        String   @id @default(uuid())
  packageId String
  serviceId String
  quantity  Int
  createdAt DateTime @default(now())

  package ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([packageId, serviceId])
  @@index([serviceId])
  @@map("package_items")
}

model Sale {
  id            String     @id @default(uuid())
  tenantId      String
  branchId      String
  customerId    String
  status        SaleStatus @default(DRAFT)
  subtotal      Decimal    @db.Decimal(10, 2)
  discountTotal Decimal    @default(0) @db.Decimal(10, 2)
  total         Decimal    @db.Decimal(10, 2)
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items            SaleItem[]
  customerPackages CustomerPackage[]
  payments         SalePayment[]
  installmentPlan  InstallmentPlan?

  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("sales")
}

model SaleItem {
  id          String       @id @default(uuid())
  saleId      String
  type        SaleItemType
  serviceId   String?
  packageId   String?
  description String
  quantity    Int          @default(1)
  unitPrice   Decimal      @db.Decimal(10, 2)
  lineTotal   Decimal      @db.Decimal(10, 2)
  createdAt   DateTime     @default(now())

  sale    Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  service Service?        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  package ServicePackage? @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@map("sale_items")
}

model SalePayment {
  id           String        @id @default(uuid())
  tenantId     String
  branchId     String
  saleId       String
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod
  status       PaymentStatus @default(COMPLETED)
  paidAt       DateTime      @default(now())
  refundedAt   DateTime?
  refundReason String?
  reference    String?
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                 Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sale                   Sale                    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  installmentAllocations InstallmentAllocation[]

  @@index([tenantId, branchId, paidAt])
  @@index([tenantId, saleId])
  @@index([tenantId, status])
  @@index([tenantId, method])
  @@map("sale_payments")
}

model InstallmentPlan {
  id               String   @id @default(uuid())
  tenantId         String
  branchId         String
  saleId           String   @unique
  installmentCount Int
  intervalMonths   Int      @default(1)
  firstDueAt       DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sale         Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  installments Installment[]

  @@index([tenantId, branchId])
  @@map("installment_plans")
}

model Installment {
  id                String   @id @default(uuid())
  installmentPlanId String
  sequence          Int
  amount            Decimal  @db.Decimal(10, 2)
  dueAt             DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  installmentPlan InstallmentPlan         @relation(fields: [installmentPlanId], references: [id], onDelete: Cascade)
  allocations     InstallmentAllocation[]

  @@unique([installmentPlanId, sequence])
  @@index([dueAt])
  @@map("installments")
}

model InstallmentAllocation {
  id            String   @id @default(uuid())
  installmentId String
  salePaymentId String
  amount        Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  installment Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  salePayment SalePayment @relation(fields: [salePaymentId], references: [id], onDelete: Cascade)

  @@unique([installmentId, salePaymentId])
  @@index([salePaymentId])
  @@map("installment_allocations")
}

model ChartOfAccount {
  id        String      @id @default(uuid())
  tenantId  String
  companyId String
  parentId  String?
  code      String
  name      String
  type      AccountType
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   ChartOfAccount?   @relation("ChartOfAccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ChartOfAccount[]  @relation("ChartOfAccountTree")
  lines    JournalEntryLine[]

  @@unique([companyId, code])
  @@index([tenantId, companyId, type])
  @@index([parentId])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id            String             @id @default(uuid())
  tenantId      String
  companyId     String
  branchId      String?
  number        String
  status        JournalEntryStatus @default(DRAFT)
  entryDate     DateTime
  description   String
  referenceType String?
  referenceId   String?
  postedAt      DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  lines   JournalEntryLine[]

  @@unique([companyId, number])
  @@index([tenantId, companyId, entryDate])
  @@index([branchId, entryDate])
  @@index([tenantId, status])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String   @id @default(uuid())
  journalEntryId String
  accountId      String
  debit          Decimal  @default(0) @db.Decimal(12, 2)
  credit         Decimal  @default(0) @db.Decimal(12, 2)
  memo           String?
  createdAt      DateTime @default(now())

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

model CustomerPackage {
  id          String                @id @default(uuid())
  tenantId    String
  branchId    String
  customerId  String
  packageId   String
  saleId      String
  status      CustomerPackageStatus @default(ACTIVE)
  purchasedAt DateTime              @default(now())
  expiresAt   DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  package  ServicePackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  sale     Sale           @relation(fields: [saleId], references: [id], onDelete: Restrict)
  sessions Session[]

  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("customer_packages")
}

model Session {
  id                String        @id @default(uuid())
  tenantId          String
  branchId          String
  customerPackageId String
  serviceId         String
  appointmentId     String?       @unique
  status            SessionStatus @default(AVAILABLE)
  consumedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerPackage CustomerPackage @relation(fields: [customerPackageId], references: [id], onDelete: Cascade)
  service         Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  appointment     Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, customerPackageId, status])
  @@index([tenantId, serviceId, status])
  @@map("sessions")
}

enum CustomerSource {
  INSTAGRAM
  GOOGLE
  REFERRAL
  WALK_IN
  OTHER
}

enum CustomerDocumentType {
  KVKK_NOTICE
  EXPLICIT_CONSENT
  MEMBERSHIP_AGREEMENT
  HEALTH_FORM
  HEALTH_DATA_CONSENT
}

enum CustomerConsentType {
  KVKK_ACKNOWLEDGEMENT
  EXPLICIT_CONSENT
  MEMBERSHIP_AGREEMENT
  HEALTH_FORM_COMPLETION
  HEALTH_DATA_CONSENT
  MARKETING_SMS
  MARKETING_EMAIL
  MARKETING_PHONE
}

enum CustomerConsentStatus {
  ACCEPTED
  DECLINED
}

enum ConsentSource {
  WEB
  STAFF
  KIOSK
  DIGITAL_SIGNATURE
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum PaymentStatus {
  COMPLETED
  REFUNDED
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum SaleItemType {
  SERVICE
  PACKAGE
}

enum CustomerPackageStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum SessionStatus {
  AVAILABLE
  RESERVED
  CONSUMED
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
