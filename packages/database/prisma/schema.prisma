generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]

  @@map("users")
}

model Tenant {
  id                     String                  @id @default(uuid())
  name                   String
  slug                   String                  @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  appointments           Appointment[]
  customers              Customer[]
  memberships            Membership[]
  roles                  Role[]
  services               Service[]
  staff                  Staff[]
  payments               Payment[]
  customerDocuments      CustomerDocument[]
  customerConsents       CustomerConsent[]
  customerHealthProfiles CustomerHealthProfile[]
  customerCareEvents     CustomerCareEvent[]
  companies              Company[]

  // Control Plane & Zero-Trust Security
  modules                TenantModule[]
  devices                TenantDevice[]
  allowedIps             TenantAllowedIp[]
  securityPolicy         TenantSecurityPolicy?
  platformAuditLogs      PlatformAuditLog[]
  impersonationSessions  ImpersonationSession[]

  @@map("tenants")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum RoleScope {
  CENTRAL
  COMPANY
  BRANCH
}

model Company {
  id        String        @id @default(uuid())
  tenantId  String
  name      String
  slug      String
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches    Branch[]
  memberships Membership[]
  roles       Role[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("companies")
}

model Branch {
  id        String       @id @default(uuid())
  companyId String
  name      String
  code      String
  status    BranchStatus @default(ACTIVE)
  address   String?
  phone     String?
  email     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  company                Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  membershipAccess       MembershipBranchAccess[]
  customers              Customer[]
  customerHealthProfiles CustomerHealthProfile[]
  customerDocuments     CustomerDocument[]
  customerConsents      CustomerConsent[]
  customerCareEvents    CustomerCareEvent[]
  appointments           Appointment[]
  staff                  Staff[]
  services               Service[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, status])
  @@map("branches")
}

model Membership {
  id             String                   @id @default(uuid())
  userId         String
  tenantId       String
  companyId      String?
  status         MembershipStatus         @default(ACTIVE)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  roleId         String
  role           Role                     @relation(fields: [roleId], references: [id])
  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company        Company?                 @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchAccesses MembershipBranchAccess[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([companyId])
  @@index([userId])
  @@index([roleId])
  @@map("memberships")
}

model MembershipBranchAccess {
  membershipId String
  branchId     String
  createdAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([membershipId, branchId])
  @@index([branchId])
  @@map("membership_branch_access")
}

model Role {
  id              String           @id @default(uuid())
  tenantId        String
  companyId       String?
  name            String
  slug            String
  description     String?
  scope           RoleScope        @default(COMPANY)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  memberships     Membership[]
  rolePermissions RolePermission[]
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, scope])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  resource        String
  action          String
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Customer {
  id             String                 @id @default(uuid())
  tenantId       String
  branchId       String
  firstName      String
  lastName       String
  phone          String?
  email          String?
  birthDate      DateTime?
  customerSource CustomerSource?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  appointments   Appointment[]
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  healthProfile  CustomerHealthProfile?
  documents      CustomerDocument[]
  consents       CustomerConsent[]
  careEvents     CustomerCareEvent[]

  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, birthDate])
  @@index([tenantId, customerSource])
  @@map("customers")
}

model CustomerHealthProfile {
  branchId      String
  id            String    @id @default(uuid())
  tenantId      String
  customerId    String    @unique
  formVersion   String?
  allergies     String?
  sensitivities String?
  medications   String?
  conditions    String?
  notes         String?
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([branchId])
  @@map("customer_health_profiles")
}

model CustomerDocument {
  branchId    String               
id          String               @id @default(uuid())
  tenantId    String
  customerId  String?
  type        CustomerDocumentType
  version     String
  title       String
  content     String?
  fileUrl     String?
  publishedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer Customer?         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  consents CustomerConsent[]

  @@index([tenantId, type, version])
  @@index([tenantId, customerId])
  @@index([branchId])
  @@map("customer_documents")
}

model CustomerConsent {
  branchId          String                
id                String                @id @default(uuid())
  tenantId          String
  customerId        String
  documentId        String?
  type              CustomerConsentType
  status            CustomerConsentStatus
  documentVersion   String
  acceptedAt        DateTime?
  source            ConsentSource
  ipAddress         String?
  userAgent         String?
  signedAt          DateTime?
  signedDocumentUrl String?
  documentHash      String?
  createdAt         DateTime              @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  document CustomerDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([tenantId, customerId])
  @@index([tenantId, customerId, type])
  @@index([branchId])
  @@map("customer_consents")
}

enum CustomerCareEventType {
  REACTION
  AFTERCARE
  COMPLAINT
  FOLLOW_UP
  INCIDENT
  NOTE
}

enum CustomerCareEventStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum CustomerCary {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CustomerCareSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model CustomerCareEvent {
  branchId      String                  
id            String                  @id @default(uuid())
  tenantId      String
  customerId    String
  appointmentId String?
  staffId       String?
  type          CustomerCareEventType
  status        CustomerCareEventStatus @default(OPEN)
  severity      CustomerCareSeverity?
  title         String
  description   String?
  onsetAt       DateTime?
  occurredAt    DateTime                @default(now())
  actionTaken   String?
  followUpAt    DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  staff       Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([tenantId, customerId, occurredAt])
  @@index([tenantId, customerId, status])
  @@index([branchId])
  @@index([tenantId, type])
  @@index([tenantId, followUpAt])
  @@map("customer_care_events")
}

model Staff {
  id           String              @id @default(uuid())
  tenantId     String
  branchId     String
  firstName    String
  lastName     String
  phone        String?
  email        String?
  profile      Json?
  status       StaffStatus         @default(ACTIVE)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  appointments Appointment[]
  careEvents   CustomerCareEvent[]
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@index([tenantId, email])
  @@map("staff")
}

model Service {
  id              String        @id @default(uuid())
  tenantId        String
  branchId        String
  name            String
  description     String?
  durationMinutes Int
  price           Decimal       @db.Decimal(10, 2)
  status          ServiceStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  appointments    Appointment[]
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@map("services")
}

model Appointment {
  id         String            @id @default(uuid())
  tenantId   String
  branchId   String
  customerId String
  staffId    String
  serviceId  String
  startAt    DateTime
  endAt      DateTime
  status     AppointmentStatus @default(SCHEDULED)
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  branch     Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer   Customer            @relation(fields: [customerId], references: [id])
  service    Service             @relation(fields: [serviceId], references: [id])
  staff      Staff               @relation(fields: [staffId], references: [id])
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment    Payment?
  careEvents CustomerCareEvent[]

  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId])
  @@index([tenantId, branchId, startAt])
  @@index([tenantId, startAt])
  @@index([tenantId, customerId])
  @@index([tenantId, staffId])
  @@index([tenantId, status])
  @@map("appointments")
}

model Payment {
  id            String        @id @default(uuid())
  tenantId      String
  appointmentId String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        PaymentStatus @default(COMPLETED)
  paidAt        DateTime      @default(now())
  refundedAt    DateTime?
  refundReason  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, paidAt])
  @@index([tenantId, method])
  @@index([tenantId, status])
  @@map("payments")
}

enum CustomerSource {
  INSTAGRAM
  GOOGLE
  REFERRAL
  WALK_IN
  OTHER
}

enum CustomerDocumentType {
  KVKK_NOTICE
  EXPLICIT_CONSENT
  MEMBERSHIP_AGREEMENT
  HEALTH_FORM
  HEALTH_DATA_CONSENT
}

enum CustomerConsentType {
  KVKK_ACKNOWLEDGEMENT
  EXPLICIT_CONSENT
  MEMBERSHIP_AGREEMENT
  HEALTH_FORM_COMPLETION
  HEALTH_DATA_CONSENT
  MARKETING_SMS
  MARKETING_EMAIL
  MARKETING_PHONE
}

enum CustomerConsentStatus {
  ACCEPTED
  DECLINED
}

enum ConsentSource {
  WEB
  STAFF
  KIOSK
  DIGITAL_SIGNATURE
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum PaymentStatus {
  COMPLETED
  REFUNDED
}

// ==========================================
// CONTROL PLANE & SUPERADMIN PLATFORM MODELS
// ==========================================

model PlatformAdmin {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String
  firstName             String
  lastName              String
  role                  PlatformAdminRole      @default(SUPPORT_AGENT)
  isActive              Boolean                @default(true)
  twoFactorEnabled      Boolean                @default(false)
  twoFactorSecret       String?
  lastLoginAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  approvedDevices       TenantDevice[]
  auditLogs             PlatformAuditLog[]
  impersonationSessions ImpersonationSession[]

  @@map("platform_admins")
}

model PlatformModule {
  id               String                 @id @default(uuid())
  code             String                 @unique // e.g. CORE, INVENTORY, HR, ACCOUNTING, MARKETING, CLINICAL, PORTAL
  name             String                 // e.g. 'Gelişmiş Stok Yönetimi'
  description      String?
  category         PlatformModuleCategory @default(OPERATIONS)
  basePriceMonthly Decimal                @default(0)
  basePriceYearly  Decimal                @default(0)
  isCore           Boolean                @default(false)
  isActive         Boolean                @default(true)
  sortOrder        Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  tenantModules    TenantModule[]

  @@map("platform_modules")
}

model TenantModule {
  id         String             @id @default(uuid())
  tenantId   String
  moduleId   String
  status     TenantModuleStatus @default(ACTIVE)
  expiresAt  DateTime?
  price      Decimal?
  config     Json?              // e.g. quotas, custom parameters
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module     PlatformModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
  @@map("tenant_modules")
}

model TenantDevice {
  id                String               @id @default(uuid())
  tenantId          String
  deviceIdentifier  String               // Unique hardware/browser fingerprint hash
  deviceName        String               // e.g. 'Kasa iPad Pro', 'Resepsiyon PC'
  deviceType        DeviceType           @default(TABLET)
  osInfo            String?              // e.g. 'iOS 18.1', 'Windows 11'
  browserInfo       String?              // e.g. 'Safari 18.0', 'Chrome 131'
  lastIpAddress     String
  status            DeviceApprovalStatus @default(PENDING)
  approvedAt        DateTime?
  approvedByAdminId String?              // Only PlatformAdmin (You or delegated admins)
  rejectionReason   String?
  lastActiveAt      DateTime             @default(now())
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvedByAdmin   PlatformAdmin?       @relation(fields: [approvedByAdminId], references: [id])

  @@unique([tenantId, deviceIdentifier])
  @@map("tenant_devices")
}

model TenantAllowedIp {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String?  // Optional branch association
  ipAddress String   // Single IP (88.255.12.34) or CIDR (88.255.12.0/24)
  label     String   // e.g. 'Kadıköy Şube Sabit Wi-Fi'
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_allowed_ips")
}

model TenantSecurityPolicy {
  id                      String                @id @default(uuid())
  tenantId                String                @unique
  ipRestrictionMode       IpRestrictionMode     @default(RELAXED)
  deviceRestrictionMode   DeviceRestrictionMode @default(STRICT_BLOCK)
  allowDoctorRemoteAccess Boolean               @default(true)
  maxAllowedDevices       Int                   @default(10)
  autoBlockOnExportSpike  Boolean               @default(true) // DLP anomaly guard
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  tenant                  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_security_policies")
}

model PlatformAuditLog {
  id              String         @id @default(uuid())
  platformAdminId String?
  tenantId        String?
  action          String         // e.g. DEVICE_APPROVED, DEVICE_BLOCKED, MODULE_TOGGLED
  targetEntity    String         // e.g. TenantDevice, TenantModule, Tenant
  targetId        String?
  ipAddress       String
  userAgent       String?
  details         Json?
  createdAt       DateTime       @default(now())

  platformAdmin   PlatformAdmin? @relation(fields: [platformAdminId], references: [id])
  tenant          Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("platform_audit_logs")
}

model ImpersonationSession {
  id                 String        @id @default(uuid())
  platformAdminId    String
  tenantId           String
  ticketNumber       String        // e.g. '#VAL-1042'
  reason             String        // Support reason
  isCustomerApproved Boolean       @default(false)
  startedAt          DateTime      @default(now())
  endedAt            DateTime?
  ipAddress          String

  platformAdmin      PlatformAdmin @relation(fields: [platformAdminId], references: [id])
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("impersonation_sessions")
}

enum PlatformAdminRole {
  SUPER_ADMIN
  SECURITY_ADMIN
  SUPPORT_AGENT
  BILLING_ADMIN
}

enum PlatformModuleCategory {
  CORE
  OPERATIONS
  FINANCE
  MARKETING
  CLINICAL
  INTELLIGENCE
}

enum TenantModuleStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  CANCELLED
}

enum DeviceType {
  TABLET
  MOBILE
  DESKTOP
  OTHER
}

enum DeviceApprovalStatus {
  PENDING
  APPROVED
  BLOCKED
  REVOKED
}

enum IpRestrictionMode {
  DISABLED
  RELAXED
  STRICT
}

enum DeviceRestrictionMode {
  DISABLED
  ALERT_ONLY
  STRICT_BLOCK
}
