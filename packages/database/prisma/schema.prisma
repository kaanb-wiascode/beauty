generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]

  @@map("users")
}

model Tenant {
  id                     String                  @id @default(uuid())
  name                   String
  slug                   String                  @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  appointments           Appointment[]
  customers              Customer[]
  memberships            Membership[]
  roles                  Role[]
  services               Service[]
  staff                  Staff[]
  payments               Payment[]
  customerDocuments      CustomerDocument[]
  customerConsents       CustomerConsent[]
  customerHealthProfiles CustomerHealthProfile[]
  customerCareEvents     CustomerCareEvent[]
  companies              Company[]

  @@map("tenants")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum RoleScope {
  CENTRAL
  COMPANY
  BRANCH
}

model Company {
  id        String        @id @default(uuid())
  tenantId  String
  name      String
  slug      String
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches    Branch[]
  memberships Membership[]
  roles       Role[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("companies")
}

model Branch {
  id        String       @id @default(uuid())
  companyId String
  name      String
  code      String
  status    BranchStatus @default(ACTIVE)
  address   String?
  phone     String?
  email     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  company                Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  membershipAccess       MembershipBranchAccess[]
  customers              Customer[]
  customerHealthProfiles CustomerHealthProfile[]
  customerDocuments     CustomerDocument[]
  customerConsents      CustomerConsent[]
  customerCareEvents    CustomerCareEvent[]
  appointments           Appointment[]
  staff                  Staff[]
  services               Service[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, status])
  @@map("branches")
}

model Membership {
  id             String                   @id @default(uuid())
  userId         String
  tenantId       String
  companyId      String?
  status         MembershipStatus         @default(ACTIVE)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  roleId         String
  role           Role                     @relation(fields: [roleId], references: [id])
  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company        Company?                 @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchAccesses MembershipBranchAccess[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([companyId])
  @@index([userId])
  @@index([roleId])
  @@map("memberships")
}

model MembershipBranchAccess {
  membershipId String
  branchId     String
  createdAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([membershipId, branchId])
  @@index([branchId])
  @@map("membership_branch_access")
}

model Role {
  id              String           @id @default(uuid())
  tenantId        String
  companyId       String?
  name            String
  slug            String
  description     String?
  scope           RoleScope        @default(COMPANY)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  memberships     Membership[]
  rolePermissions RolePermission[]
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, scope])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  resource        String
  action          String
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Customer {
  id             String                 @id @default(uuid())
  tenantId       String
  branchId       String
  firstName      String
  lastName       String
  phone          String?
  email          String?
  birthDate      DateTime?
  customerSource CustomerSource?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  appointments   Appointment[]
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  healthProfile  CustomerHealthProfile?
  documents      CustomerDocument[]
  consents       CustomerConsent[]
  careEvents     CustomerCareEvent[]

  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, birthDate])
  @@index([tenantId, customerSource])
  @@map("customers")
}

model CustomerHealthProfile {
  branchId      String
  id            String    @id @default(uuid())
  tenantId      String
  customerId    String    @unique
  formVersion   String?
  allergies     String?
  sensitivities String?
  medications   String?
  conditions    String?
  notes         String?
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([branchId])
  @@map("customer_health_profiles")
}

model CustomerDocument {
  branchId    String               
id          String               @id @default(uuid())
  tenantId    String
  customerId  String?
  type        CustomerDocumentType
  version     String
  title       String
  content     String?
  fileUrl     String?
  publishedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer Customer?         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  consents CustomerConsent[]

  @@index([tenantId, type, version])
  @@index([tenantId, customerId])
  @@index([branchId])
  @@map("customer_documents")
}

model CustomerConsent {
  branchId          String                
id                String                @id @default(uuid())
  tenantId          String
  customerId        String
  documentId        String?
  type              CustomerConsentType
  status            CustomerConsentStatus
  documentVersion   String
  acceptedAt        DateTime?
  source            ConsentSource
  ipAddress         String?
  userAgent         String?
  signedAt          DateTime?
  signedDocumentUrl String?
  documentHash      String?
  createdAt         DateTime              @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  document CustomerDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([tenantId, customerId])
  @@index([tenantId, customerId, type])
  @@index([branchId])
  @@map("customer_consents")
}

enum CustomerCareEventType {
  REACTION
  AFTERCARE
  COMPLAINT
  FOLLOW_UP
  INCIDENT
  NOTE
}

enum CustomerCareEventStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum CustomerCary {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CustomerCareSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model CustomerCareEvent {
  branchId      String                  
id            String                  @id @default(uuid())
  tenantId      String
  customerId    String
  appointmentId String?
  staffId       String?
  type          CustomerCareEventType
  status        CustomerCareEventStatus @default(OPEN)
  severity      CustomerCareSeverity?
  title         String
  description   String?
  onsetAt       DateTime?
  occurredAt    DateTime                @default(now())
  actionTaken   String?
  followUpAt    DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  staff       Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([tenantId, customerId, occurredAt])
  @@index([tenantId, customerId, status])
  @@index([branchId])
  @@index([tenantId, type])
  @@index([tenantId, followUpAt])
  @@map("customer_care_events")
}

model Staff {
  id           String              @id @default(uuid())
  tenantId     String
  branchId     String
  firstName    String
  lastName     String
  phone        String?
  email        String?
  profile      Json?
  status       StaffStatus         @default(ACTIVE)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  appointments Appointment[]
  careEvents   CustomerCareEvent[]
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@index([tenantId, email])
  @@map("staff")
}

model Service {
  id              String        @id @default(uuid())
  tenantId        String
  branchId        String
  name            String
  description     String?
  durationMinutes Int
  price           Decimal       @db.Decimal(10, 2)
  status          ServiceStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  appointments    Appointment[]
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@map("services")
}

model Appointment {
  id         String            @id @default(uuid())
  tenantId   String
  branchId   String
  customerId String
  staffId    String
  serviceId  String
  startAt    DateTime
  endAt      DateTime
  status     AppointmentStatus @default(SCHEDULED)
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  branch     Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer   Customer            @relation(fields: [customerId], references: [id])
  service    Service             @relation(fields: [serviceId], references: [id])
  staff      Staff               @relation(fields: [staffId], references: [id])
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment    Payment?
  careEvents CustomerCareEvent[]

  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId])
  @@index([tenantId, branchId, startAt])
  @@index([tenantId, startAt])
  @@index([tenantId, customerId])
  @@index([tenantId, staffId])
  @@index([tenantId, status])
  @@map("appointments")
}

model Payment {
  id            String        @id @default(uuid())
  tenantId      String
  appointmentId String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        PaymentStatus @default(COMPLETED)
  paidAt        DateTime      @default(now())
  refundedAt    DateTime?
  refundReason  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, paidAt])
  @@index([tenantId, method])
  @@index([tenantId, status])
  @@map("payments")
}

enum CustomerSource {
  INSTAGRAM
  GOOGLE
  REFERRAL
  WALK_IN
  OTHER
}

enum CustomerDocumentType {
  KVKK_NOTICE
  EXPLICIT_CONSENT
  MEMBERSHIP_AGREEMENT
  HEALTH_FORM
  HEALTH_DATA_CONSENT
}

enum CustomerConsentType {
  KVKK_ACKNOWLEDGEMENT
  EXPLICIT_CONSENT
  MEMBERSHIP_AGREEMENT
  HEALTH_FORM_COMPLETION
  HEALTH_DATA_CONSENT
  MARKETING_SMS
  MARKETING_EMAIL
  MARKETING_PHONE
}

enum CustomerConsentStatus {
  ACCEPTED
  DECLINED
}

enum ConsentSource {
  WEB
  STAFF
  KIOSK
  DIGITAL_SIGNATURE
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum PaymentStatus {
  COMPLETED
  REFUNDED
}
