NODE_ENV=development
PORT=3000
DATABASE_URL=
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

QUALITY_NOTIFICATION_WEBHOOK_URL=
QUALITY_NOTIFICATION_WEBHOOK_SECRET=
QUALITY_NOTIFICATION_WEBHOOK_TIMEOUT_MS=5000
QUALITY_FEEDBACK_PUBLIC_TOKEN_SECRET=

# Private S3-compatible object storage (AWS S3, MinIO, R2-compatible gateway, etc.)
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_PRESIGN_TTL_SECONDS=300
OBJECT_STORAGE_MAX_BYTES=26214400

# Reporting exports. Defaults to filesystem for local/dev; set to object for multi-instance deployments.
REPORT_EXPORT_STORAGE_DRIVER=filesystem
REPORT_EXPORT_STORAGE_DIR=.report-exports
REPORT_EXPORT_RETENTION_DAYS=7
REPORT_EXPORT_WORKER_ENABLED=false
REPORT_EXPORT_STALE_PROCESSING_MINUTES=30
REPORT_EXPORT_STALE_BATCH_SIZE=100
REPORT_EXPORT_ACTIVE_JOB_LIMIT=3
REPORT_EXPORT_ROW_LIMIT=50000
REPORT_SCHEDULE_BATCH_SIZE=5
