NODE_ENV=development
PORT=3000
RELEASE_SHA=
CORS_ORIGINS=http://localhost:3001
TRUST_PROXY=false
PUBLIC_API_URL=http://localhost:3000
DATABASE_URL=
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Marketing provider credentials are encrypted before storage.
MARKETING_INTEGRATION_MASTER_KEY=
MARKETING_INTEGRATION_MASTER_KEY_VERSION=v1
MARKETING_INTEGRATION_PREVIOUS_MASTER_KEYS=

# Meta Marketing OAuth. Use the current endpoints/version configured for your Meta app.
META_OAUTH_CLIENT_ID=
META_OAUTH_CLIENT_SECRET=
META_OAUTH_AUTHORIZATION_URL=
META_OAUTH_TOKEN_URL=
META_OAUTH_REDIRECT_URI=http://localhost:3001/communications/integrations/oauth/callback
META_OAUTH_SCOPES=ads_read,leads_retrieval,business_management
META_GRAPH_API_BASE_URL=https://graph.facebook.com
# Set this to the Graph API version approved/configured for your Meta app.
META_GRAPH_API_VERSION=

# Google Ads OAuth web-server flow.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/communications/integrations/oauth/callback
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/adwords
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v25
# Optional: manager/MCC customer id, without hyphens.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# TikTok API for Business / Marketing API. Authorization URL is generated in TikTok API for Business portal.
TIKTOK_BUSINESS_APP_ID=
TIKTOK_BUSINESS_SECRET=
TIKTOK_BUSINESS_AUTHORIZATION_URL=
TIKTOK_BUSINESS_TOKEN_URL=https://business-api.tiktok.com/open_api/v1.3/oauth2/access_token/
# Optional verification endpoint. Use {advertiser_id} placeholder where required by the chosen TikTok API endpoint.
TIKTOK_BUSINESS_VERIFY_URL=
TIKTOK_BUSINESS_CAMPAIGN_LIST_URL=https://business-api.tiktok.com/open_api/v1.3/campaign/get/
TIKTOK_BUSINESS_REPORT_URL=https://business-api.tiktok.com/open_api/v1.3/report/integrated/get/

QUALITY_NOTIFICATION_WEBHOOK_URL=
QUALITY_NOTIFICATION_WEBHOOK_SECRET=
QUALITY_NOTIFICATION_WEBHOOK_TIMEOUT_MS=5000
QUALITY_FEEDBACK_PUBLIC_TOKEN_SECRET=

# Private S3-compatible object storage (AWS S3, MinIO, R2-compatible gateway, etc.)
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_PRESIGN_TTL_SECONDS=300
OBJECT_STORAGE_MAX_BYTES=26214400

# Optional speech-to-text for Team voice messages. Use an OpenAI-compatible audio transcription endpoint.
TEAM_TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
TEAM_TRANSCRIPTION_API_KEY=
TEAM_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Reporting exports. Defaults to filesystem for local/dev; set to object for multi-instance deployments.
REPORT_EXPORT_STORAGE_DRIVER=filesystem
REPORT_EXPORT_STORAGE_DIR=.report-exports
REPORT_EXPORT_RETENTION_DAYS=7
REPORT_EXPORT_WORKER_ENABLED=false
REPORT_EXPORT_WORKER_POLL_MS=5000
REPORT_EXPORT_WORKER_BATCH_SIZE=5
REPORT_EXPORT_EXPIRY_BATCH_SIZE=100
REPORT_EXPORT_STALE_PROCESSING_MINUTES=30
REPORT_EXPORT_STALE_BATCH_SIZE=100
REPORT_EXPORT_ACTIVE_JOB_LIMIT=3
REPORT_EXPORT_ROW_LIMIT=50000
REPORT_SCHEDULE_BATCH_SIZE=5

# Production requirements:
# - RELEASE_SHA must be the exact 40-character Git commit SHA.
# - CORS_ORIGINS and PUBLIC_API_URL must use HTTPS.
# - Private object storage must be fully configured.
# - REPORT_EXPORT_STORAGE_DRIVER=object
# - REPORT_EXPORT_WORKER_ENABLED=true
