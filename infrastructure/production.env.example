# Copy to a secret-managed environment file outside Git.
# Never commit populated values.

RELEASE_SHA=0123456789abcdef0123456789abcdef01234567
API_IMAGE=ghcr.io/kaanb-wiascode/beauty-api:0123456789abcdef0123456789abcdef01234567
WEB_IMAGE=ghcr.io/kaanb-wiascode/beauty-web:0123456789abcdef0123456789abcdef01234567

WEB_PORT=3001
CORS_ORIGINS=https://app.example.com
PUBLIC_API_URL=https://app.example.com/backend

DATABASE_URL=postgresql://USER:PASSWORD@PRIVATE_HOST:5432/valoo?sslmode=require
REDIS_URL=rediss://:PASSWORD@PRIVATE_HOST:6379

JWT_ACCESS_SECRET=replace-with-secret-store-value-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-secret-store-value-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

OBJECT_STORAGE_BUCKET=valoo-production-private
OBJECT_STORAGE_REGION=eu-central-1
OBJECT_STORAGE_ENDPOINT=https://object-storage.example.com
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-secret-store-value
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-secret-store-value
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_PRESIGN_TTL_SECONDS=300
OBJECT_STORAGE_MAX_BYTES=26214400

REPORT_EXPORT_RETENTION_DAYS=7
REPORT_EXPORT_WORKER_POLL_MS=5000
REPORT_EXPORT_WORKER_BATCH_SIZE=5
REPORT_EXPORT_EXPIRY_BATCH_SIZE=100
REPORT_EXPORT_STALE_PROCESSING_MINUTES=30
REPORT_EXPORT_STALE_BATCH_SIZE=100
REPORT_EXPORT_ACTIVE_JOB_LIMIT=3
REPORT_EXPORT_ROW_LIMIT=50000
REPORT_SCHEDULE_BATCH_SIZE=5
